<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);JARIBU_MULTI</DefineConstants>
    <!-- run-ci-tests.cs is a file-based program that <Compile Include>s test files
         carrying #: directives/shebangs; .NET 10 SDK (10.0.301+) requires this opt-in
         to process those transitive directives. -->
    <ExperimentalFileBasedProgramEnableTransitiveDirectives>true</ExperimentalFileBasedProgramEnableTransitiveDirectives>
    <!-- Enable AOT-compatible configuration binding for IOptions<T> tests -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- Suppress unused parameter warnings in test lambdas -->
    <!-- Suppress namespace style warnings for tests with top-level statements + namespace blocks -->
    <!-- CA5399: the shared NuGetVersionService creates HttpClient without enabling
         CRL checks; the consuming CLI (tools/dev-cli) already suppresses this. -->
    <NoWarn>$(NoWarn);RCS1163;IDE0161;IDE0065;CA5399</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- ALL test files are included via recursive glob so that new tests are picked up
         automatically — CI coverage must not silently drift (kanban task 454-001).
         If you CREATE A NEW tests/<something>-tests DIRECTORY, you must add its glob
         (and any ProjectReference/Using it needs) here, or its tests will never run.
         Anything that cannot run in multi-mode MUST be listed in CiTestExcludes below
         with a reason; do not switch back to hand-enumerated includes. -->
    <!-- generator-17: tests local functions in TOP-LEVEL STATEMENTS by design; it cannot
         exist inside the multi-mode assembly (the runner owns the entry point). Run it
         standalone: dotnet run tests/timewarp-nuru-tests/generator/generator-17-local-function-config.cs -->
    <!-- engine-01: references ParsedInput/InputTokenizer, types removed from source in the
         #360 refactor; does not compile standalone either. Delete or rewrite (task 454-001 notes). -->
    <!-- generator-28: Roslyn-hosted generator test; references timewarp-nuru-analyzers as a
         LIBRARY, whose shared parsing types (Lexer/Token) collide with timewarp-nuru's in one
         compilation (CS0433). Run standalone by run-ci-tests.cs as a second phase instead. -->
    <!-- generator-30: same Roslyn-hosted generator test pattern as generator-28; CS0433
         collision applies. Run standalone instead. -->
    <!-- generator-34/35/36: same Roslyn-hosted generator test pattern as generator-28
         (kanban 454-012 / M8); CS0433 collision applies. Run standalone instead. -->
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-17-local-function-config.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/completion/engine/engine-01-input-tokenizer.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-28-interpreter-cycle-guard.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-29-h002-named-arguments.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-30-nuru-r003-overlap.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-31-m7-param-mismatch.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-32-m9-unrelated-fluent.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-33-m6-failsoft-catch.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-34-m8-ilistmanager-repeated.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-35-m8-idata-service.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-36-m8-typeconverter-fqn.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-37-incrementality-caching.cs" />
    <CiTestExcludes Include="../timewarp-nuru-tests/generator/generator-38-h002-sole-identifier-body.cs" />
    <Compile
      Include="../timewarp-nuru-tests/**/*.cs"
      Exclude="../timewarp-nuru-tests/**/obj/**;../timewarp-nuru-tests/**/bin/**;@(CiTestExcludes)" />
    <!-- Search tests (timewarp-nuru-search: FTS index) -->
    <Compile Include="../timewarp-nuru-search-tests/*.cs" />
    <!-- MCP server tests -->
    <!-- mcp-02: GetSyntaxTool's default (endpoint) path asserts MCP:endpoint-* regions
         that exist nowhere — only the fluent syntax file is embedded. Product bug tracked
         in kanban task 454-033; re-include this file when fixed. -->
    <Compile
      Include="../timewarp-nuru-mcp-tests/*.cs"
      Exclude="../timewarp-nuru-mcp-tests/mcp-02-syntax-documentation.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- DevCli service files compiled INTO the CI test assembly so that
         NuGetVersionService.CompareVersions / IsVersionPublished are testable.
         ONLY the service files are included — the endpoint file
         (check-version-command.cs) carries [NuruRoute("check-version")] whose
         handler requires IRepoConfigService; endpoints are collected GLOBALLY
         in multi-mode, so including it would give every .DiscoverEndpoints()
         test app an endpoint with an unregistered service -> NURU050 build
         errors across CI (task 454-022 decision A2). -->
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/nuget-version-service.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/dev-cli-json-context.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/repo-config.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/check-version-config.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/attestation-config.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/attestation-verifier.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/ci-mode.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/tag-assertion.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/publish-state.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/release-guard.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/repo-config-service.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/irepo-config-service.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/ipackable-project-service.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/packable-project-service.cs" />
    <Compile Include="$(SourceDirectory)timewarp-nuru-devcli/content/any/services/ci-run-promotion.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceDirectory)timewarp-nuru/timewarp-nuru.csproj" />
    <ProjectReference Include="$(SourceDirectory)timewarp-nuru-mcp/timewarp-nuru-mcp.csproj" />
    <ProjectReference Include="$(SourceDirectory)timewarp-nuru-search/timewarp-nuru-search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TimeWarp.Nuru.Tests.LexerTests.LexerTestHelper" Static="true" />
    <!-- Global usings for migrated test files -->
    <Using Include="TimeWarp.Nuru" />
    <Using Include="Shouldly" />
    <Using Include="System.ComponentModel.DataAnnotations" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Options" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="System.Net" />
    <!-- MCP tools namespace -->
    <Using Include="TimeWarp.Nuru.Mcp.Tools" />
    <!-- Search services namespace -->
    <Using Include="TimeWarp.Nuru.Search.Services" />
    <!-- repo-config-service.cs calls Git.FindRoot(); TimeWarp.Amuru.Git lives in the
         TimeWarp.Amuru.Tools package (not core TimeWarp.Amuru, which only flows in
         transitively via ProjectReference) — reference it directly, plus the namespace
         global using since this test project doesn't declare one. -->
    <Using Include="TimeWarp.Amuru" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packages for configuration tests -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="TimeWarp.Amuru.Tools" />
  </ItemGroup>
</Project>
