<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <ItemGroup>
    <!-- Subjects for the constructor-dependency runfile. Multi-mode already
         globs tests/**/*.cs, so this include is limited to that project.
         MSBuildProjectName for a file-based app keeps the .cs suffix. -->
    <Compile
      Include="generator-26-constructor-dependency-fixtures.cs"
      Condition="'$(MSBuildProjectName)' == 'generator-26-constructor-dependency-resolution.cs'" />
  </ItemGroup>
</Project>
