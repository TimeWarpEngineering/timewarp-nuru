<Project>
  <!-- File-based tests do not restore the Nuru package, so they do not import
       build/TimeWarp.Nuru.targets. Point the AOT JSON context task at the local build. -->
  <PropertyGroup>
    <_NuruBuildTaskDir>$(MSBuildThisFileDirectory)../source/timewarp-nuru-build/bin/$(Configuration)/net10.0/</_NuruBuildTaskDir>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../source/timewarp-nuru-build/build/TimeWarp.Nuru.Build.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)../source/timewarp-nuru-build/build/TimeWarp.Nuru.Build.targets')" />
</Project>
