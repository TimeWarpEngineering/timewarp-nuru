<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- CS0436: each test generates TimeWarp.Mediator.Generated.Mediator, and TimeWarp.Nuru.Mcp
         (an app, so a mediator host) already contains that internal type, visible through
         InternalsVisibleTo. The compiler uses the local type. TimeWarp.Nuru no longer emits one
         (task 566), so only tests that reference TimeWarp.Nuru.Mcp need this. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="TimeWarp.Nuru.Mcp.Tools" />
  </ItemGroup>
</Project>
