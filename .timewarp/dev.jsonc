{
  // Per-repo configuration for TimeWarp.Nuru dev-cli
  "checkVersionConfig": {
    // Package set is derived from projects with IsPackable=true under source/
    // (kanban task 458-004). Set "packages" (comma-separated NuGet package IDs)
    // here only to override the derived set.
    //
    // "feeds" (kanban task 564): nuget.org | github-packages, comma-separated.
    // Absent means nuget.org, which is the only feed this repo publishes to, so
    // the publish gates never contact GitHub Packages or need a token for it.
  },

  // Attestation verify step (kanban tasks 458-010, 458-011). Values:
  // off | warn | require. One key for all pipeline modes.
  // Defaults when unset/blank: PR/merge → warn; release → require
  // (TimeWarp-first: release still hard-gates unless you set mode).
  // Explicit "warn" is advisory on release too; "off" skips verify entirely.
  // CLI override: dev workflow --attestation off|warn|require
  // Uncomment and set once ganda has attested this repo (or set "require"
  // explicitly if you want require on both PR and release — blank is
  // require-only on release).
  // "attestation": {
  //   "mode": "warn"
  // }

  // Pull request build decision (kanban task 595): additions to the
  // PullRequestBuildClassifier rule in TimeWarp.Nuru.DevCli. An entry is a path,
  // "dir/", or "dir/**". buildPaths always build; nonBuildPaths skip, but never
  // source/, tests/, tools/, msbuild/, .github/workflows/, or .editorconfig.
  // readme.md and assets/logo.png are packed into the nupkgs, so they build.
  // These match the push trigger's paths-ignore in .github/workflows/workflow.yml.
  "pullRequestBuild": {
    "buildPaths": ["readme.md", "assets/logo.png"],
    "nonBuildPaths": ["skills/**", ".agent/**", ".claude/**"]
  }
}