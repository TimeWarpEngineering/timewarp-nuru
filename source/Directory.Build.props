<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- TFM of dependency DLLs packed into analyzers/dotnet/cs. Both timewarp-nuru
         and timewarp-nuru-analyzers pack Microsoft.Extensions.Logging.Abstractions
         for the analyzer host; defining the TFM once prevents the packages from
         silently drifting to different builds of the same DLL (kanban 454-026). -->
    <AnalyzerDependencyTfm>net10.0</AnalyzerDependencyTfm>
  </PropertyGroup>

  <!-- Default package metadata (can be overridden in individual projects) -->
  <PropertyGroup Label="Package Metadata">
    <Version>3.0.0-beta.80</Version>
    <Authors>Steven T. Cramer</Authors>
    <RepositoryUrl>https://github.com/TimeWarpEngineering/timewarp-nuru</RepositoryUrl>
    <PackageProjectUrl>https://timewarp.software/projects/timewarp-nuru/</PackageProjectUrl>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Label="MsBuild Packaging Defaults">
    <IsPackable>true</IsPackable>
    <PackageOutputPath>$(ArtifactsDirectory)packages/</PackageOutputPath>
  </PropertyGroup>

  <!-- Pack only Release builds. Samples, tests, and file-based programs reference
       these projects and build them in Debug; with GeneratePackageOnBuild
       unconditional, any Debug build repacked a Debug nupkg over the Release one
       in artifacts/packages, and CI uploaded/promoted that artifact (published
       3.0.0-beta.79 and beta.80 carry Debug assemblies; task 503). -->
  <PropertyGroup Label="Release-only packing">
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup Label="Source Link Settings">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>false</IncludeSymbols>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup Label="Shared Package Assets">
    <None Include="$(RepositoryRoot)assets/logo.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- TimeWarp.Build.Tasks is referenced repo-wide in the root Directory.Build.props. -->

</Project>