{
  // Per-repo configuration for TimeWarp.Nuru dev-cli
  "checkVersionConfig": {
    // Package set is derived from projects with IsPackable=true under source/
    // (kanban task 458-004). Set "packages" (comma-separated NuGet package IDs)
    // here only to override the derived set.
  }

  // Attestation verify step (kanban tasks 458-010, 458-011). Values:
  // off | warn | require. One key for all pipeline modes.
  // Defaults when unset/blank: PR/merge → warn; release → require
  // (TimeWarp-first: release still hard-gates unless you set mode).
  // Explicit "warn" is advisory on release too; "off" skips verify entirely.
  // CLI override: dev workflow --attestation off|warn|require
  // Uncomment and set once ganda has attested this repo (or set "require"
  // explicitly if you want require on both PR and release — blank is
  // require-only on release).
  // "attestation": {
  //   "mode": "warn"
  // }
}