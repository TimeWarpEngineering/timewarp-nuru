{
  // Per-repo configuration for TimeWarp.Nuru dev-cli
  "checkVersionConfig": {
    // Package set is derived from projects with IsPackable=true under source/
    // (kanban task 458-004). Set "packages" (comma-separated NuGet package IDs)
    // here only to override the derived set.
  }

  // Attestation verify step (kanban task 458-010). Uncomment to opt this
  // repo's PR/merge-mode `dev workflow` into "require" once ganda has
  // attested this repo at least once (default is "warn": prints a loud
  // advisory when the tree is unattested but never fails the pipeline).
  // Release mode ALWAYS hard-gates on attestation regardless of this
  // setting — this only controls PR/merge-mode enforcement.
  // "attestation": {
  //   "mode": "warn"
  // }
}